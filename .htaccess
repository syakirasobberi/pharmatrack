# Serve the app from the project root (e.g. https://d09097.schtg.com/pharmatrack)
# by forwarding every request into public/. public/.htaccess handles the rest.
# Files outside public/ (.env, vendor, storage...) are never served directly.
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback if mod_rewrite is unavailable: deny everything rather than expose files.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
